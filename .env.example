# ---- Server ----
PORT=3000
# Interface to listen on. Loopback by default, because the API can print, clear
# the queue, and read your calendar and tasks. To reach it from other devices
# (phone, Home Assistant), set HOST=0.0.0.0 AND DASHBOARD_PASSWORD; the app
# refuses to start exposed without one.
HOST=127.0.0.1
# HTTP Basic password for the dashboard and API (any username works). The webhook
# uses WEBHOOK_TOKEN instead, so automations don't need this.
DASHBOARD_PASSWORD=
# Timezone used for schedules and "today" calculations
TZ_NAME=America/Chicago

# ---- Printer ----
# CUPS raw queue name (already created on this machine as "PrintNotify")
PRINTER_QUEUE=PrintNotify
# Characters per line: TM-T88VI @ 80mm, Font A = 42, Font B = 56
PRINTER_WIDTH=42
# Set true to skip physical printing (writes bytes to data/last-receipt.bin instead)
PRINTER_DRY_RUN=false

# ---- Schedules (cron syntax) ----
# Full digest every morning at 7:00
MORNING_DIGEST_CRON=0 7 * * *
# Evening digest at 18:00 — the same sources shifted to TOMORROW (tomorrow's
# calendar and forecast, birthdays counted from tomorrow, next games instead of
# last night's finals), so it prints while you can still prepare for it.
# Set empty to disable the evening receipt.
EVENING_DIGEST_CRON=0 18 * * *
# Poll sources for urgent items every 15 minutes. Deliberately offset off the
# quarter-hour: at */15 this fires at :00, the same tick as the morning digest,
# so both run a full fetchAll() at once and double every source's upstream load
# at the one moment of the day nobody is watching.
POLL_CRON=7,22,37,52 * * * *

# ---- Source: Weather (Open-Meteo, no API key) ----
# Leave blank to disable. Find your coords at https://open-meteo.com
WEATHER_LAT=
WEATHER_LON=
# How long a fetched reading is reused. The dashboard, preview, urgent poll and
# digest all funnel through one cache, and concurrent callers share a single
# request — without this, the 7am digest and the :00 urgent poll each opened
# their own connections on the same tick.
WEATHER_CACHE_MINUTES=15
# Open-Meteo 503s transiently. Rather than dropping the weather section from the
# morning digest, serve the last good reading up to this age (labelled "as of
# Nm ago" on the receipt). Past this the source fails honestly.
WEATHER_STALE_MINUTES=180
# Air quality (US AQI + PM2.5) and pollen, from Open-Meteo's air-quality API —
# same vendor, still keyless. Pollen is a European-model product, so outside its
# domain (e.g. the US) that line is simply omitted. Best-effort: a failure here
# never breaks the forecast.
WEATHER_AIR_QUALITY=true
# US AQI at or above this prints an urgent air-quality item (101 = the EPA's
# "unhealthy for sensitive groups" threshold).
WEATHER_AQI_ALERT=101

# ---- Weather alerts (NWS, api.weather.gov, no API key, US-only) ----
# Prints an alert receipt the moment a National Weather Service warning/advisory/
# watch for WEATHER_LAT/LON is issued, updated, or expires. Auto-on when weather is
# enabled; set false to disable. Non-US points simply have no alerts.
WEATHER_ALERTS_ENABLED=true
# How often (seconds) to poll NWS for new/updated/expired alerts.
WEATHER_ALERTS_INTERVAL=120
# Which alert categories trigger an immediate printout (by the last word of the NWS
# event name). Others still show in the digest but never wake the printer.
WEATHER_ALERTS_PRINT_TYPES=warning,advisory,watch
# NWS asks clients to send an identifying User-Agent with contact info.
NWS_USER_AGENT=print-notify (you@example.com)

# ---- Source: GitHub notifications ----
# Personal access token with "notifications" scope. Leave blank to disable.
GITHUB_TOKEN=

# ---- Source: Calendar (iCal / .ics secret URL, no OAuth) ----
# Google Calendar > Settings > "Secret address in iCal format". Leave blank to disable.
CALENDAR_ICS_URL=

# ---- Source: Birthdays & anniversaries (same ICS plumbing) ----
# Google publishes contact birthdays as a yearly-recurring all-day event, so we
# project RRULE:FREQ=YEARLY forward and print anything inside the window — far
# enough ahead that you can still do something about it.
BIRTHDAYS_ENABLED=true
# Defaults to CALENDAR_ICS_URL. Point this at Google's own "Birthdays" calendar
# (it has its own secret .ics) to keep them out of the main timeline. With a
# dedicated feed every event counts; sharing the main feed applies the keywords.
BIRTHDAYS_ICS_URL=
BIRTHDAYS_WINDOW_DAYS=45
BIRTHDAYS_KEYWORDS=birthday,bday,anniversary,'s day

# ---- Source: Sports scores (ESPN public API, no key) ----
# Comma-separated "<league>:<team abbreviation>". Leave blank to disable.
# Leagues: nfl, ncaaf/cfb, mlb, nba, wnba, ncaam, ncaaw, nhl, mls, epl
# e.g. SPORTS_TEAMS=mlb:MIN,nfl:MIN,ncaaf:SDSU
SPORTS_TEAMS=
# How far back a final score still counts as "last night's result".
SPORTS_LOOKBACK_HOURS=36

# ---- Source: TLS cert + domain expiry ----
# Comma-separated hosts to watch, e.g. "fallstech.group,visualsentinel.com:443".
# Certs come from a real TLS handshake; domain expiry from RDAP (keyless).
# Leave blank to disable. Nothing prints until something is close to expiring —
# a healthy fleet is silent.
CERT_WATCH=
# Also look up domain-registration expiry via RDAP for each host's domain.
CERT_CHECK_DOMAINS=true
# Start surfacing an entry this many days before it expires...
CERT_NOTICE_DAYS=30
# ...and escalate it to 'urgent' (which wakes the printer via POLL_CRON) here.
CERT_URGENT_DAYS=7
CERT_TIMEOUT_MS=8000

# ---- Source: Local news (Google News RSS, no API key) ----
NEWS_ENABLED=true
NEWS_QUERY=Sioux Falls, SD
NEWS_LIMIT=5
# Comma-separated case-insensitive substrings; a headline is dropped when any
# appears in its title, outlet, or URL. Defaults filter out obituaries.
# Set to empty (NEWS_EXCLUDE=) to disable filtering.
NEWS_EXCLUDE=obituary,obituaries,obit,death notice,in memoriam,funeral home,legacy.com

# ---- Source: Google Tasks (pen-checkable task + grocery lists) ----
# Setup (one time):
#   1. console.cloud.google.com -> new project -> enable "Google Tasks API"
#   2. APIs & Services -> Credentials -> Create OAuth client -> type "Desktop app"
#   3. Put the client id/secret below, then run:  npm run google-auth
#      (approve in browser; it prints GOOGLE_REFRESH_TOKEN to paste here)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which Google Tasks list titles to print, comma-separated (blank = all lists):
GOOGLE_TASKS_LISTS=Tasks,Groceries
# Include completed tasks (pre-checked)? Usually false for a fresh checklist.
GOOGLE_TASKS_SHOW_COMPLETED=false

# ---- Grocery price estimates (keyless) ----
# Annotate the Groceries checklist with per-item price estimates + a total.
# Uses the nearest city (reverse-geocoded from WEATHER_LAT/LON). Live prices are
# looked up per item via SerpAPI: Walmart.com first, then Google Shopping if the
# item isn't found on Walmart. Results are cached 30 days in data/prices.db; the
# bundled region-adjusted seed table (BLS Average Price Data, refreshable with
# `npm run refresh-prices`) is the fallback when SERPAPI_KEY is unset, the budget
# is spent, or nothing matches. Estimates are approximate ("~"). Needs
# WEATHER_LAT/LON. Set true to enable.
GROCERY_PRICES_ENABLED=false
# SerpAPI key (https://serpapi.com) for live Walmart + Google Shopping prices.
# Leave blank to use only the offline BLS seed table. Free plan is 250
# searches/month; an item not found on Walmart spends a 2nd search on Google.
SERPAPI_KEY=
# Optional overrides for the SerpAPI budget guard and cache freshness:
# SERPAPI_MONTHLY_LIMIT=250
# SERPAPI_HOURLY_LIMIT=50
# GROCERY_PRICE_CACHE_DAYS=30

# ---- Sentinel: Visual Sentinel uptime monitoring (polls every SENTINEL_INTERVAL sec) ----
# Prints an ad-hoc receipt only when a monitor goes DOWN (not UI-change/load/SSL).
# Never repeats for an ongoing outage; re-alerts only if it recovers then fails again.
# Get a key at https://visualsentinel.com/settings/api-keys
SENTINEL_ENABLED=true
SENTINEL_INTERVAL=60
VS_API_KEY=

# ---- Print reliability: hold-and-retry queue ----
# CUPS accepts a job whether or not the printer can actually print it — with the
# cover open or the paper out, `lp` exits 0 and the receipt is gone. Every
# receipt goes through a queue that checks printer health first and holds the job
# on disk (data/print-queue.json) when the answer is "not right now", then prints
# it on recovery. This is what makes an unattended 7am digest trustworthy.
PRINT_QUEUE_ENABLED=true
# How often to retry held jobs, in seconds.
PRINT_QUEUE_RETRY_SEC=60
# Give up on a job after this long, so a week-long outage doesn't dump a stack of
# stale digests when paper is finally loaded.
PRINT_QUEUE_MAX_AGE_HOURS=12
# Cap the backlog; past this the oldest held jobs are dropped.
PRINT_QUEUE_MAX_JOBS=20

# ---- Receipt archive ----
# Keep a rolling archive of rendered receipts (PNG + metadata) so the dashboard
# can answer "what did it print on Tuesday?". Served at /api/receipts.
RECEIPT_ARCHIVE_ENABLED=true
RECEIPT_ARCHIVE_KEEP=30
RECEIPT_ARCHIVE_DIR=data/receipts

# On startup, print a digest whose scheduled time passed within this many hours
# while the app was down. 0 disables catch-up.
DIGEST_CATCHUP_HOURS=3

# ---- Inbound webhook (token-guarded) ----
# Lets Home Assistant, an iOS Shortcut, or a physical button make paper appear:
#   curl -X POST -H "Authorization: Bearer $TOKEN" \
#        'http://localhost:3000/api/hooks/print?day=tomorrow'
#   curl -X POST -H "Authorization: Bearer $TOKEN" \
#        'http://localhost:3000/api/hooks/print?what=checklist'
# Disabled entirely until a token is set. Generate one with:
#   openssl rand -hex 24
WEBHOOK_TOKEN=
