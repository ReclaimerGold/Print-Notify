{
  "name": "print-notify",
  "version": "0.1.0",
  "description": "Pull notifications from APIs, build digests, and print them to an Epson TM-T88VI receipt printer.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test-print": "tsx scripts/test-print.ts",
    "google-auth": "tsx scripts/google-auth.ts",
    "refresh-prices": "tsx scripts/refresh-prices.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "node-thermal-printer": "^4.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
